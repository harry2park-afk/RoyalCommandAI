# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RoyalCommand.ai

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers (server-only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=

# Unified catalog connector for additional AI providers
OPENROUTER_API_KEY=

# Demo mode: when true, missing AI keys use simulated responses
AI_DEMO_MODE=true

# Security
VOICE_SIGNATURE_SECRET=change-me-in-production
LOG_LEVEL=info
